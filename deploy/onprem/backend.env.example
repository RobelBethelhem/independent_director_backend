# Copy to backend.env (same folder) and fill in real values on the Application
# Server. NEVER commit the real backend.env — it's gitignored.
#
# Generate strong secrets with, e.g.:  openssl rand -hex 32

NODE_ENV=production
PORT=3000

# Same-origin via the nginx reverse proxy, but CORS still checks this — set it
# to whatever URL staff actually use to reach the portal.
FRONTEND_ORIGIN=http://10.1.1.94

# --- Database (segregated Database Server, 10.1.1.174) ---
# User/password must match what you set in deploy/db/postgres.env on the DB server.
DATABASE_URL=postgres://REPLACE_DB_USER:REPLACE_DB_PASSWORD@10.1.1.174:5432/zemen_director_portal
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# Initial admin seeded on first boot if no admin exists yet.
SEED_ADMIN_EMAIL=admin@zemen.test
SEED_ADMIN_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# JWT — generate two distinct long random secrets, do not reuse Render's.
JWT_ACCESS_SECRET=REPLACE_ME_RANDOM_64_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=REPLACE_ME_DIFFERENT_RANDOM_64_HEX
JWT_REFRESH_TTL=7d

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=4
# Keep false here — this is a real deployment; staff/applicants must receive
# the actual email OTP, not have it echoed back in the API response.
OTP_DEV_MODE=false

# --- Email (SMTP) — point at the bank's real mail relay/provider ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Zemen Bank <no-reply@zemenbank.com>

# --- Object storage — the `minio` service in docker-compose.onprem.yml ---
# S3_ACCESS_KEY / S3_SECRET_KEY MUST match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# in deploy/onprem/minio.env.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=zemen-documents
S3_ACCESS_KEY=REPLACE_ME_MATCH_MINIO_ROOT_USER
S3_SECRET_KEY=REPLACE_ME_MATCH_MINIO_ROOT_PASSWORD
S3_FORCE_PATH_STYLE=true
