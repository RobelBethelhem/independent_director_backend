# Copy to backend.env (same folder) and fill in real values on the Application
# Server. NEVER commit the real backend.env — it's gitignored.
#
# Generate strong secrets with, e.g.:  openssl rand -hex 32

NODE_ENV=production
PORT=3000

# The public URL users actually type into the browser. Set it to the PUBLIC
# HTTPS origin when the app is reached through a public reverse proxy
# (e.g. https://applybod.zemenbank.com); comma-separate extra origins if it's
# also reached internally (e.g. https://applybod.zemenbank.com,http://10.1.2.136:8080).
FRONTEND_ORIGIN=https://applybod.zemenbank.com

# Number of trusted reverse-proxy hops in front of the app, so the real client
# IP is used for rate limiting / audit / the IP blocklist. 1 = a single edge;
# 2 = public access chained through DMZ nginx -> app nginx -> app.
TRUST_PROXY_HOPS=2

# --- Database (segregated Database Server, 10.1.2.21) ---
# User/password must match what you set in deploy/db/postgres.env on the DB server.
# Port 3306 is the externally-published port (the one opened on the DB
# server's firewall) — Postgres itself still runs on its native 5432 inside
# the container; only the host-facing mapping was changed. Not a MySQL port.
DATABASE_URL=postgres://REPLACE_DB_USER:REPLACE_DB_PASSWORD@10.1.2.21:3306/zemen_director_portal
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# Initial admin seeded on first boot if no admin exists yet.
SEED_ADMIN_EMAIL=admin@zemen.test
SEED_ADMIN_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# JWT — generate two distinct long random secrets, do not reuse Render's.
JWT_ACCESS_SECRET=REPLACE_ME_RANDOM_64_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=REPLACE_ME_DIFFERENT_RANDOM_64_HEX
JWT_REFRESH_TTL=7d

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
# Keep false here — this is a real deployment; staff/applicants must receive
# the actual email OTP, not have it echoed back in the API response.
OTP_DEV_MODE=false

# --- Email (SMTP) — the bank's internal mail relay ---
# Left blank, OTP/notification emails are only logged, never actually sent —
# that's why email "doesn't work" until this is filled in with real credentials.
# Host/port/secure below match the bank's internal relay (confirmed working
# config, reused from the RTGS system's integration) — only SMTP_USER/PASS
# need filling in, plus MAIL_FROM if a different sender address is preferred.
SMTP_HOST=smtp.zemenbank.com
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Zemen Bank <no-reply@zemenbank.com>
# The bank's internal mail relay uses a certificate Node doesn't trust by
# default (self-signed / internal CA) — matches the RTGS integration's
# `tls: { rejectUnauthorized: false }`. Leave true for this specific relay.
SMTP_TLS_INSECURE=true

# --- SMS (Zemen Bank internal gateway) — OTP + password-reset codes send by
# SMS alongside email whenever the account has a phone number. Same
# log-only-if-blank fallback as SMTP above.
SMS_GATEWAY_URL=https://smsgateway.zemenbank.com/http-api/send
SMS_USERNAME=
SMS_PASSWORD=
# Sender ID / shortcode registered against THIS username — confirm with
# whoever issued the SMS_USERNAME/SMS_PASSWORD above; don't assume another
# project's shortcode carries over to a different gateway account.
SMS_FROM=

# --- Object storage — the `minio` service in docker-compose.onprem.yml ---
# S3_ACCESS_KEY / S3_SECRET_KEY MUST match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# in deploy/onprem/minio.env.
S3_ENDPOINT=http://minio:9000
# The browser fetches presigned upload/download URLs directly, so this must be
# the SAME public origin the browser is on — otherwise HTTPS pages get
# mixed-content-blocked and the internal IP isn't reachable from the internet.
# Set it to the public HTTPS origin (must match how users reach the site). The
# bucket path is proxied same-origin (frontend/nginx.conf), and the public
# reverse proxy must forward the Host header unchanged (proxy_set_header Host
# $host) or MinIO's presigned-URL signature check fails.
S3_PUBLIC_ENDPOINT=https://applybod.zemenbank.com
S3_REGION=us-east-1
S3_BUCKET=zemen-documents
S3_ACCESS_KEY=REPLACE_ME_MATCH_MINIO_ROOT_USER
S3_SECRET_KEY=REPLACE_ME_MATCH_MINIO_ROOT_PASSWORD
S3_FORCE_PATH_STYLE=true

# --- Access-control blocklist ---
# IPs that are always allowed to sign in and are exempt from the admin IP
# blocklist. Set this to your admin workstation(s)/subnet so a mistaken block
# can't lock out the people who clear blocks. Comma-separated. Example:
#   SECURITY_IP_ALLOWLIST=10.1.2.50,10.1.2.51
SECURITY_IP_ALLOWLIST=127.0.0.1,::1
