# Copy to onprem.env (same folder) and adjust if your network policy dictates
# a specific port. Controls docker-compose.onprem.yml's variable substitution
# ONLY (not the app itself) — safe to commit, no secrets here.
#
# Deliberately a separate, explicitly-named file rather than relying on
# Compose's implicit ".env" auto-loading, so it never collides with the
# unrelated local-dev backend/.env used outside Docker.
#
# The host-facing HTTP port for the portal (nginx listens on 80 *inside* the
# container either way — only the externally-published port changes). Many
# network policies won't open bare port 80 on an internal app server; pick
# whatever port your network team approves.
APP_HTTP_PORT=8080

# If you change this, also update FRONTEND_ORIGIN in backend.env to match
# exactly what staff type into their browser, e.g. http://10.1.2.136:8080
